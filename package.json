{
  "name": "vue-admin",
  "version": "0.1.0",
  "private": true,
  "web-types": "./web-types.json",
  "scripts": {
    "dev": "vite --port 8082",
    "serve": "vite --port 8082",
    "build": "vue-tsc --noEmit && vite build",
    "build-only": "vite build",
    "build-staging": "vite build --mode staging",
    "build-release": "vite build --mode release",
    "build-test": "vite build --mode test",
    "preview": "vite preview --port 8082",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint --flag unstable_native_nodejs_ts_config .",
    "lint:fix": "eslint --flag unstable_native_nodejs_ts_config . --fix",
    "report": "vite build --mode report",
    "server": "cross-env NODE_ENV=production node server.mts",
    "new": "node ./script/generateView.mts",
    "gen:components": "node ./script/genGlobalComponents.mts"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@ant-design/icons-vue": "^7.0.1",
    "@antv/data-set": "^0.10.2",
    "@antv/g2": "^3.5.8",
    "ant-design-vue": "^4.2.6",
    "apexcharts": "^3.24.0",
    "axios": "^1.20.0",
    "china-city-data": "^1.0.1",
    "clipboard": "^2.0.11",
    "dayjs": "^1.11.23",
    "deepmerge": "^4.3.1",
    "driver.js": "^1.8.0",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "http-proxy-middleware": "^4.2.0",
    "md5": "^2.3.0",
    "nprogress": "^0.2.0",
    "perfect-scrollbar": "^1.5.6",
    "pinia": "^4.0.3",
    "qs": "^6.16.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.42",
    "vue-cropper": "^1.1.4",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/md5": "^2.3.6",
    "@types/node": "^22.20.3",
    "@types/nprogress": "^0.2.3",
    "@types/qs": "^6.15.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "less": "^4.9.1",
    "postcss": "^8.5.28",
    "postcss-pxtorem": "^6.1.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.104.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vite-plugin-compression": "^0.5.1",
    "vue-tsc": "^3.3.11"
  }
}
